# Development Dockerfile for Auth Service (Go) - Single stage for faster builds
FROM golang:1.23-alpine

# Install runtime dependencies
RUN apk add --no-cache git ca-certificates tzdata protobuf-dev curl

# Create app user (matching docker-compose user: "1000:1000")
RUN addgroup -g 1000 -S appgroup && \
    adduser -u 1000 -S appuser -G appgroup

# Set working directory
WORKDIR /app

# Create cache directories and change ownership
RUN mkdir -p /go/pkg/mod/cache /go/cache && \
    chown -R appuser:appgroup /go /app

# Switch to non-root user
USER appuser

# Install protoc plugins and Air for hot reload as appuser
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.28.1 && \
    go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.2.0 && \
    go install github.com/cosmtrek/air@v1.49.0

# Set Go environment variables for proper cache handling
ENV GOCACHE=/go/cache
ENV GOMODCACHE=/go/pkg/mod

# Copy go mod files
COPY --chown=appuser:appgroup go.mod go.sum ./

# Download dependencies
RUN go mod download

# Expose ports
EXPOSE 8080 50051

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Development command with Air for hot reload
CMD ["/go/bin/air", "-c", ".air.toml"]