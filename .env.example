# ============================================================================
# Auth Service Environment Configuration
# ============================================================================
# 
# ⚠️  IMPORTANT: This module now uses the unified infrastructure approach.
# 
# For development, the infrastructure provides all services automatically.
# Use: cd ../infrastructure && make dev-full-stack
#
# This file is for reference and local development only.
# ============================================================================

# Database Configuration (Infrastructure PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=erp_auth
DB_SSL_MODE=disable

# Redis Configuration (Infrastructure Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# Server Configuration
HTTP_PORT=8080
GRPC_PORT=50051
GIN_MODE=debug

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Kafka Configuration (Infrastructure Kafka)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=auth-events
KAFKA_GROUP_ID=auth-service-group

# Environment
ENV=development
LOG_LEVEL=debug

# ============================================================================
# Container Environment Variables (Used by docker-compose.full-stack.yml)
# ============================================================================
# When running in containers, these values are automatically set:
#
# DB_HOST=postgres
# REDIS_HOST=redis  
# KAFKA_BROKERS=kafka:29092
# 
# The infrastructure handles service discovery and networking automatically.